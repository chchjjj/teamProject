	</select>
	
	<update id="updateDelivery" parameterType="hashmap">
		UPDATE ORDER_TBL
		SET DELIVERY_TYPE = #{deliveryType}
		WHERE ORDER_ID = #{orderId}
	</update>
	
	<insert id="insertPayment" parameterType="hashmap"> 
		INSERT INTO PAYMENT_TBL 
		VALUES (PAYMENT_SEQ.NEXTVAL, #{orderId} ) 
	</insert>
</mapper>